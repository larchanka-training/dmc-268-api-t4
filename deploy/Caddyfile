# SITE_ADDRESS comes from /opt/dmc268/.env: the server IP with dashes plus .sslip.io.
# Caddy obtains a Let's Encrypt certificate for it (HTTP-01 on port 80), keeps it in the
# caddy_data volume and redirects http to https.
{$SITE_ADDRESS} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The bare server IP has no certificate: send old http://<IP> links to the site name
# instead of Caddy's default redirect to https://<IP>, which fails in the browser.
http://{$SERVER_IP} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
