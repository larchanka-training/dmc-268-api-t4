__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.env
.pytest_cache/
.idea/
/.opencode/
/openspec/

# Credentials — the GitHub App private key downloads as a .pem and cannot be
# re-downloaded, only regenerated. Never commit it.
*.pem
*.key
*.p12
# Exception: test-only keys, which must be committed for the suite to run in CI.
# They sign nothing real and are generated by the repo, not by GitHub.
!tests/fixtures/**/*.pem
!tests/fixtures/**/*.key
.env.*
!.env.example
*.egg-info/
