+@app.get("/users")
+def list_users(sort: str = "name"):
+    conn = get_connection()
+    rows = conn.execute(f"SELECT id, name, email FROM users ORDER BY {sort}").fetchall()
+    return [{"id": r[0], "name": r[1], "email": r[2]} for r in rows]
 
 
